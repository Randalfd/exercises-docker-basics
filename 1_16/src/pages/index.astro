---
/**
 * Página única de la aplicación.
 * El contenido es deliberadamente irrelevante: solo sirve para tener
 * algo que renderizar y verificar que el deploy en Vercel funciona.
 */
const page = {
  title: 'Deploy de prueba',
  subtitle: 'Una sola página, sin información útil',
  facts: [
    { label: 'Framework', value: 'Astro' },
    { label: 'Páginas', value: '1' },
    { label: 'Dependencias', value: '1' },
    { label: 'Estado', value: 'De prueba' },
  ],
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{page.title}</title>
    <style>
      :root {
        color-scheme: light dark;
        --bg: #f6f7f9;
        --fg: #16181d;
        --muted: #5c6270;
        --card: #ffffff;
        --border: #e2e5ea;
      }

      @media (prefers-color-scheme: dark) {
        :root {
          --bg: #101216;
          --fg: #f2f3f5;
          --muted: #a2a8b5;
          --card: #181b21;
          --border: #2a2f38;
        }
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        min-height: 100vh;
        display: grid;
        place-items: center;
        padding: 2rem 1rem;
        background: var(--bg);
        color: var(--fg);
        font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto,
          Helvetica, Arial, sans-serif;
        line-height: 1.55;
      }

      main {
        width: 100%;
        max-width: 34rem;
      }

      .card {
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: 14px;
        padding: 1.75rem;
      }

      h1 {
        margin: 0 0 0.25rem;
        font-size: 1.6rem;
        letter-spacing: -0.01em;
      }

      .subtitle {
        margin: 0 0 1.5rem;
        color: var(--muted);
        font-size: 0.95rem;
      }

      dl {
        display: grid;
        grid-template-columns: auto 1fr;
        gap: 0.5rem 1rem;
        margin: 0 0 1.5rem;
        font-size: 0.92rem;
      }

      dt {
        color: var(--muted);
      }

      dd {
        margin: 0;
        font-variant-numeric: tabular-nums;
      }

      .note {
        margin: 0;
        padding-top: 1rem;
        border-top: 1px solid var(--border);
        color: var(--muted);
        font-size: 0.85rem;
      }

      code {
        background: var(--bg);
        border: 1px solid var(--border);
        border-radius: 5px;
        padding: 0.1rem 0.35rem;
        font-size: 0.85em;
      }
    </style>
  </head>
  <body>
    <main>
      <section class="card">
        <h1>{page.title}</h1>
        <p class="subtitle">{page.subtitle}</p>

        <dl>
          {page.facts.map((fact) => (
            <Fragment>
              <dt>{fact.label}</dt>
              <dd>{fact.value}</dd>
            </Fragment>
          ))}
        </dl>

        <p class="note">
          No hay nada acá. Si estás viendo esto en Vercel, el deploy funcionó.
          El resto se ejecuta con <code>npm run dev</code>.
        </p>
      </section>
    </main>
  </body>
</html>